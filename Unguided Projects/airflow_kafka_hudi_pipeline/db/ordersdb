CREATE USER debezium_user WITH PASSWORD 'debezium_pass'; --Create Debezium Replication User
ALTER USER debezium_user WITH REPLICATION LOGIN; -- Grant replication + login
GRANT CONNECT ON DATABASE postgres TO debezium_user; -- Grant DB access
GRANT USAGE ON SCHEMA public TO debezium_user; -- Grant schema & table access
GRANT SELECT ON ALL TABLES IN SCHEMA public TO debezium_user;
ALTER DEFAULT PRIVILEGES IN SCHEMA public -- Future tables access
GRANT SELECT ON TABLES TO debezium_user;


create table events(
event_id varchar(30), 
user_id varchar(30),
event_type varchar(30) NOT NULL,
product_id varchar(30) NOT NULL,
price numeric(10,2),
event_time TIMESTAMP default current_timestamp
);
ALTER TABLE events ADD COLUMN id BIGSERIAL PRIMARY KEY; -- a primary key column is necessary for debezium

